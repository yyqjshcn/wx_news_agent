# ============================================
# Embodied News Agent - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control
# ============================================

# -------------------------------------------
# Infrastructure
# -------------------------------------------
APP_NAME=embodied-news-agent
APP_ENV=development
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars-long

# -------------------------------------------
# PostgreSQL
# -------------------------------------------
POSTGRES_USER=embodied_news
POSTGRES_PASSWORD=embodied_news_password
POSTGRES_DB=embodied_news
POSTGRES_PORT=5432

# -------------------------------------------
# Redis
# -------------------------------------------
REDIS_PORT=6379

# -------------------------------------------
# Application URLs
# -------------------------------------------
API_PORT=8000
WEB_PORT=3000
NGINX_PORT=80

# -------------------------------------------
# Database URL (auto-constructed, override if needed)
# -------------------------------------------
# DATABASE_URL=postgresql://embodied_news:embodied_news_password@postgres:5432/embodied_news

# -------------------------------------------
# Redis URL (auto-constructed, override if needed)
# -------------------------------------------
# REDIS_URL=redis://redis:6379/0

# -------------------------------------------
# WeChat Adapter Sidecar
# -------------------------------------------
WECHAT_ADAPTER_URL=http://wechat-adapter:8080

# -------------------------------------------
# Encryption (for API keys stored in DB)
# -------------------------------------------
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-string

# -------------------------------------------
# SMTP (optional, for email notifications)
# -------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@example.com
# SMTP_TLS=true

# -------------------------------------------
# Logging
# -------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
