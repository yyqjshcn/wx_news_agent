# ============================================
# OmniNewsFlow - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control
# ============================================

# -------------------------------------------
# Infrastructure
# -------------------------------------------
APP_NAME=omninewsflow
APP_ENV=development
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars-long

# -------------------------------------------
# Redis
# -------------------------------------------
REDIS_PORT=6379

# -------------------------------------------
# Application URLs
# -------------------------------------------
API_PORT=8000
WEB_PORT=3000
NGINX_PORT=80

# -------------------------------------------
# Database (SQLite by default)
# -------------------------------------------
# The database file is stored in the sqlite_data Docker volume.
# To use a custom path or PostgreSQL instead, uncomment and set:
# DATABASE_URL=sqlite:///./data/embodied_news.db
# DATABASE_URL=postgresql://omninewsflow:omninewsflow_password@postgres:5432/omninewsflow

# -------------------------------------------
# Redis URL (auto-constructed, override if needed)
# -------------------------------------------
# REDIS_URL=redis://redis:6379/0

# -------------------------------------------
# WeChat Adapter Sidecar
# -------------------------------------------
WECHAT_ADAPTER_URL=http://wechat-adapter:8080

# -------------------------------------------
# Encryption (for API keys stored in DB)
# -------------------------------------------
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-string

# -------------------------------------------
# SMTP (optional, for email notifications)
# -------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@example.com
# SMTP_TLS=true

# -------------------------------------------
# Logging
# -------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# -------------------------------------------
# Workflow Failure Alert Webhook
# -------------------------------------------
# Set a webhook URL to receive failure alerts when any workflow fails.
# Supports Feishu, DingTalk, Slack, Discord, and generic webhooks.
# Leave empty to disable alerts.
# WORKFLOW_FAIL_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
